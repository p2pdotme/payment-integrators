# Hot key holding the gas float. Keep the balance small and refill it — this
# is a key on a public endpoint, not a treasury.
FAUCET_PRIVATE_KEY=

# Fundable deployments. No attestor field: the chain verifies attestations
# (simulation before paying, revert after), so there is no signer config to
# get wrong. An `attestor` key from an old config is ignored.
FAUCET_INTEGRATORS=[{"chainId":8453,"address":"0x","label":"own"}]

# PRODUCTION REQUIRES A KEYED ENDPOINT. mainnet.base.org is best-effort and
# rate-limited, and both money paths hold the process-wide send lock across
# 3-5 round-trips to this URL — public-endpoint throttling therefore
# serializes every cold start while /healthz stays green.
# The URL is a SECRET (the key is in the path). It is scrubbed from every
# error the service emits; treat it like the private key in the secret store.
FAUCET_RPC_URLS={"8453":"https://base-mainnet.g.alchemy.com/v2/<key>"}

# Browser origins allowed to call this directly. Leave both empty to disable
# CORS entirely (server-to-server only).
ALLOWED_ORIGINS=https://ownfinance.org
# Preview deployments get a fresh hostname per build, which no exact-match list
# can cover. Keep it anchored and project-specific — a loose pattern here turns
# "who may call us" into "anyone".
#   ^https://own-app-[a-z0-9-]+\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# MUST be an absolute path on a persistent volume. Every daily cap is a SUM
# over this file, so on ephemeral disk they reset on every deploy — silently.
# The service now REFUSES TO START on a relative path rather than leaving this
# to a runbook.
FAUCET_DB_PATH=/data/faucet.db
# Local runs and CI only: allows the relative default above.
# FAUCET_ALLOW_EPHEMERAL_DB=1

# Shared secret for /v1/ops/health (funder address, balances, spend, caps).
# Presented as a HEADER — `X-Ops-Token: <token>` or `Authorization: Bearer
# <token>` — never a query string, which every access log records. Unset =
# that endpoint 404s. /healthz returns a status word and nothing else, because
# a default-open operational endpoint on a key-holding service is a live
# budget gauge for whoever finds it.
FAUCET_OPS_TOKEN=

# Swagger/ReDoc/openapi.json. Off unless set to 1 — this process holds a key
# and is publicly reachable.
# FAUCET_ENABLE_DOCS=1

# Ceilings on what one drip's TRANSACTION may cost, as distinct from what it
# sends. Every cap below meters the amount sent only, so without these the fee
# is an unmetered spend chosen partly by the recipient's own receive() code.
# FAUCET_MAX_TRANSFER_GAS=250000
# FAUCET_MAX_FEE_PER_GAS_WEI=5000000000

# In-process rate limits (sliding minute windows). Honest throttling, not
# security — edge limiting belongs in front of the service; this stops one
# caller turning a public endpoint into an RPC-cost amplifier.
# FAUCET_RATE_IP_PER_MIN=60
# FAUCET_RATE_WALLET_PER_MIN=12
# How many proxies append to X-Forwarded-For before this process (Railway's
# edge = 1). The per-IP limiter keys on the hop that many from the RIGHT; the
# leftmost entry is the caller's own claim. 0 = no proxy, use the socket peer.
# FAUCET_TRUSTED_PROXIES=1

# Warn (event=low_balance, hourly) when the funder holds fewer than this many
# drips. The empty state is otherwise a 200 the client swallows.
# FAUCET_LOW_BALANCE_DRIPS=100

# ── policy (all optional; defaults are in faucet.py) ───────────────────────
# Target = base_fee * GAS_UNITS * SAFETY_FACTOR, clamped to [MIN, MAX].
# A full first journey measured 1.36M gas; 1.5M leaves room for facet growth.
# SAFETY_FACTOR 2 = two journeys (~3 cents at Base's usual fee). The client
# re-asks before every order, so bigger drips only prepay for refills that
# happen automatically anyway.
# FAUCET_GAS_UNITS=1500000
# FAUCET_SAFETY_FACTOR=2
# FAUCET_MIN_TARGET_WEI=10000000000000
# FAUCET_MAX_TARGET_WEI=400000000000000
# FAUCET_MAX_DRIPS_PER_WALLET=4
# FAUCET_MAX_WEI_PER_WALLET=800000000000000
# FAUCET_MAX_WEI_PER_NULLIFIER=1600000000000000
# Size this to the float you actually loaded. The default is ten times a
# realistic one, so the breaker would never trip before the wallet simply ran
# dry — which is the wrong failure: dry is silent, tripped is legible.
# FAUCET_MAX_WEI_GLOBAL=200000000000000000

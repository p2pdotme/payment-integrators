{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  // e2e.test.ts imports `test/e2e-addresses.json`, which is GENERATED by
  // `payment-integrators/scripts/e2e-setup.js` against a local chain and is
  // deliberately not committed. Excluding it keeps `npm run typecheck` green
  // on a fresh clone; the E2E suite typechecks itself when you run it.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
